# Environment Configuration for Luno Trading Bot
# Copy this file to .env or add these variables to your shell profile

# =============================================================================
# ENVIRONMENT SELECTION
# =============================================================================
# Set ENV to control which Luno environment to use:
# - DEV: Uses staging.luno.com (for testing)
# - PROD: Uses api.luno.com (for live trading)
# - If not set, defaults to PROD

ENV=DEV  # Change to PROD for live trading

# =============================================================================
# PRODUCTION CREDENTIALS (Live Trading)
# =============================================================================
# These are used when ENV=PROD or not set
# Get these from https://www.luno.com/wallet/security/api_keys

LUNO_API_KEY_ID=your_production_api_key_here
LUNO_API_SECRET=your_production_api_secret_here

# =============================================================================
# DEVELOPMENT/STAGING CREDENTIALS (Testing)
# =============================================================================
# These are used when ENV=DEV
# Get these from Luno's staging environment
# Contact Luno support for staging access

LUNO_API_KEY_ID_DEV=your_staging_api_key_here
LUNO_API_SECRET_DEV=your_staging_api_secret_here

# =============================================================================
# USAGE EXAMPLES
# =============================================================================

# Method 1: Use environment variable
# export ENV=DEV
# python run_bot.py

# Method 2: Use explicit parameter
# api = LunoAPI(environment='DEV')  # Force staging
# api = LunoAPI(environment='PROD') # Force production

# Method 3: Override in code
# api = LunoAPI(
#     api_key='your_key',
#     api_secret='your_secret',
#     environment='DEV'
# )

# =============================================================================
# SAFETY NOTES
# =============================================================================

# ⚠️  STAGING ENVIRONMENT:
# - Use for testing and development
# - Orders are placed on test exchange
# - No real money involved
# - Limited to test trading pairs

# ✅ PRODUCTION ENVIRONMENT:
# - Use for live trading only
# - Orders are placed on real exchange
# - Real money involved
# - Full access to all trading pairs

# 🔒 SECURITY:
# - Never commit real API keys to version control
# - Use .env files that are gitignored
# - Rotate keys regularly
# - Use read-only keys for monitoring bots
